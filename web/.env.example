# Frontend estatico (AppShell) - copiar a .env y completar. Nunca commitear .env real.

# --- Servidor de archivos estaticos (solo sirve web/public y web/src; no reemplaza a un CDN/hosting de produccion) ---
PORT=5173
NODE_ENV=development

# --- Backend REST/JSON existente (backend/) ---
# Nunca se hardcodea 'localhost' en el codigo del cliente: server.js inyecta
# este valor en tiempo de arranque via GET /env.js (window.__CIP_ENV__), asi
# la migracion a otro dominio (p. ej. apptest.uy o produccion) es solo una
# variable de entorno, no un cambio de codigo (ver docs/arquitectura/ambientes.md).
API_BASE_URL=http://localhost:3001

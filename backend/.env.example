# Backend del motor operativo - copiar a .env y completar. Nunca commitear .env real.

# --- Aplicacion ---
PORT=3001
NODE_ENV=development

# --- Base de datos (SQLite via node:sqlite, sin dependencias externas) ---
DB_PATH=./data/cip.sqlite

# --- IA (desacoplada del pipeline - ver src/services/ai/) ---
# Estrategia: DeepSeek (primario) -> OpenRouter (fallback). Ninguno se llama
# en el pipeline deterministico; solo estarian disponibles para explicacion/
# sintesis en una capa posterior (ver knowledge/decision/rules.json.ai_provider_independence).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Adquisicion ---
# Timeout/backoff por defecto para adaptadores reales (ver src/data/acquisition/adapters.js)
ACQUISITION_TIMEOUT_MS=10000
